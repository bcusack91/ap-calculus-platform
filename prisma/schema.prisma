generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                        @id @default(cuid())
  name                   String?
  email                  String?                       @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  role                   UserRole                      @default(FREE)
  studyContext           String                        @default("personal") // active flashcard study mode — see src/lib/study-context.ts
  satTrackOverride       String? // teacher placement for the SAT Core Skills track: 'core-skills' | 'regular'; null = automatic from the diagnostic score
  stripeCustomerId       String?                       @unique
  stripeSubscriptionId   String?                       @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  avatarData             Json? // Custom avatar configuration
  birthYear              Int? // Self-reported at signup; drives COPPA child-directed treatment for under-13
  guardianEmail          String? // Optional parent/guardian address for weekly progress emails (opt-out via EmailSubscriber)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  schoolId               String?
  classCode              String?
  accounts               Account[]
  diagnosticTests        DiagnosticTest[]
  flashcardProgress      FlashcardProgress[]
  flashcardDailyActivity FlashcardDailyActivity[]
  learningPath           LearningPath?
  sessions               Session[]
  topicProgress          TopicProgress[]
  school                 School?                       @relation(fields: [schoolId], references: [id])
  dailyStreak            DailyStreak?
  competitiveProfile     CompetitiveProfile?
  matchesAsPlayer1       CompetitiveMatch[]            @relation("Player1Matches")
  matchesAsPlayer2       CompetitiveMatch[]            @relation("Player2Matches")
  mmrHistory             MMRHistory[]
  matchmakingEntry       MatchmakingQueue?
  factoringMetrics       FactoringPerformanceMetrics[]
  sixSigmaMetrics        SixSigmaMetrics[]
  learningInsights       LearningInsights[]

  // Teacher dashboard relations
  ownedClassrooms            Classroom[]                @relation("ClassroomTeacher")
  classroomMemberships       ClassroomMember[]
  coTeaching                 ClassroomCoTeacher[]       @relation("CoTeaching")
  assignmentSubmissions      AssignmentSubmission[]
  createdAssignments         Assignment[]               @relation("AssignmentCreator")
  flashcardSets              FlashcardSet[]             @relation("TeacherFlashcardSets")
  competitionParticipations  CompetitionParticipant[]
  competitiveGrantsReceived  CompetitiveGrant[]         @relation("CompetitiveGrantStudent")
  competitiveGrantsGiven     CompetitiveGrant[]         @relation("CompetitiveGrantTeacher")
  exitQuizAttempts           ExitQuizAttempt[]
  dailyChallengeResults      DailyChallengeResult[]
  userAchievements           UserAchievement[]
  bookmarks                  Bookmark[]
  announcements              Announcement[]             @relation("AnnouncementAuthor")
  notes                      StudentNote[]
  studyPlans                 StudyPlan[]
  challengeParticipations    ChallengeParticipant[]
  asyncChallengesSent        AsyncChallenge[]           @relation("AsyncChallengeSender")
  asyncChallengesReceived    AsyncChallenge[]           @relation("AsyncChallengeRecipient")
  hostedLobbies              CompetitiveLobby[]         @relation("LobbyHost")
  joinedLobbies              CompetitiveLobby[]         @relation("LobbyGuest")
  teacherLobbies             TeacherLobby[]             @relation("TeacherLobbyTeacher")
  teacherLobbyParticipations TeacherLobbyParticipant[]  @relation("TeacherLobbyParticipantUser")
  satTestAttempts            SatTestAttempt[]
  mcatTestAttempts           McatTestAttempt[]
  unitTestAttempts           UnitTestAttempt[]
  frqAttempts                FrqAttempt[]
  diagnosticChallenges       DiagnosticChallenge[]
  diagnosticChallengeEntries DiagnosticChallengeEntry[]
}

/// Idempotency ledger for incoming Stripe webhooks. The Stripe event id is the
/// natural dedupe key — if Stripe retries a delivery, we detect the existing
/// row and skip re-processing so a user can't be double-upgraded/downgraded.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id (e.g. evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// Lightweight analytics event log. Historically created lazily via raw SQL
/// (see src/app/api/analytics/events/route.ts) and queried with $queryRaw, so it
/// lived OUTSIDE this schema — which meant `prisma db push` saw it as unknown and
/// tried to DROP it. Declared here so Prisma is aware of it (db push and the
/// migration baseline now treat it correctly). Structure mirrors the lazy
/// CREATE TABLE exactly; that IF-NOT-EXISTS create stays as a harmless safety net.
model AnalyticsEvent {
  id           BigInt   @id @default(autoincrement())
  eventName    String
  pageTemplate String?
  ctaType      String?
  location     String?
  destination  String?
  courseSlug   String?
  topicSlug    String?
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([eventName])
  @@index([pageTemplate])
  @@index([ctaType])
}

/// Admin alerting tables — like AnalyticsEvent, these were created lazily via
/// raw SQL (see src/lib/admin-alert-notifications.ts) and were therefore unknown
/// to Prisma (db push wanted to drop them). Declared here to match production
/// exactly; the lazy IF-NOT-EXISTS creates remain as harmless safety nets.
/// Index names are mapped to the existing production names.
model AdminAlertNotification {
  id             BigInt    @id @default(autoincrement())
  alertKey       String
  metric         String
  severity       String
  windowStart    DateTime  @db.Date
  windowEnd      DateTime  @db.Date
  message        String?
  channels       Json?
  notifiedAt     DateTime  @default(now()) @db.Timestamptz(6)
  acknowledgedAt DateTime? @db.Timestamptz(6)
  acknowledgedBy String?
  resolvedAt     DateTime? @db.Timestamptz(6)

  @@unique([alertKey, windowStart, windowEnd], map: "AdminAlertNotification_key_window_unique")
  @@index([alertKey, notifiedAt(sort: Desc)], map: "AdminAlertNotification_key_time_idx")
}

model AdminAlertPreference {
  alertKey     String    @id
  snoozedUntil DateTime? @db.Timestamptz(6)
  snoozedBy    String?
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([snoozedUntil])
}

model AdminAlertTicket {
  id          BigInt   @id @default(autoincrement())
  alertKey    String
  windowStart DateTime @db.Date
  windowEnd   DateTime @db.Date
  provider    String?
  externalId  String?
  ticketUrl   String?
  status      String?
  payload     Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([alertKey, windowStart, windowEnd], map: "AdminAlertTicket_key_window_unique")
}

/// Generic editable-content store (#10). Lets structured content that currently
/// lives in `src/data/*` move into the database so it can be edited without a
/// deploy, versioned, and A/B-tested. Consumers read by (type, courseSlug) and
/// fall back to the static `src/data` source when no rows exist, so migration is
/// incremental and reversible. First adopter: study-plan templates.
model ContentItem {
  id         String   @id @default(cuid())
  type       String // content family, e.g. "study-plan-template"
  courseSlug String // e.g. "ap-statistics"
  key        String // stable id within (type, courseSlug), e.g. the template id
  payload    Json // the content blob (shape depends on `type`)
  status     String   @default("PUBLISHED") // PUBLISHED | DRAFT | ARCHIVED
  version    Int      @default(1)
  updatedBy  String? // admin user id who last edited (no FK — audit-style)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, courseSlug, key])
  @@index([type, courseSlug, status])
}

/// Append-only audit trail for sensitive admin actions (e.g. changing a user's
/// role). Intentionally has NO foreign keys: audit records must survive deletion
/// of the actor/target, and email snapshots keep them readable afterward.
model AdminAuditLog {
  id          String   @id @default(cuid())
  action      String // e.g. "user.role.update"
  actorId     String // admin who performed the action
  actorEmail  String? // snapshot for readability if the actor is later removed
  targetId    String? // affected entity (e.g. the user whose role changed)
  targetEmail String? // snapshot
  details     Json? // arbitrary structured context (before/after, etc.)
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
}

model DiagnosticChallenge {
  id                 String                     @id @default(cuid())
  token              String                     @unique @default(cuid())
  creatorId          String
  diagnosticCategory String
  diagnosticForm     Int
  creatorScore       Int
  creatorCorrect     Int
  creatorTotal       Int
  creatorAPScore     Int
  creatorName        String
  visibility         String                     @default("public")
  entries            DiagnosticChallengeEntry[]
  createdAt          DateTime                   @default(now())
  expiresAt          DateTime
  creator            User                       @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([creatorId])
  @@index([expiresAt])
}

model DiagnosticChallengeEntry {
  id          String              @id @default(cuid())
  challengeId String
  userId      String
  displayName String
  score       Int
  correct     Int
  total       Int
  apScore     Int
  completedAt DateTime            @default(now())
  challenge   DiagnosticChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Course {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  order       Int
  icon        String?
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[]
}

model Topic {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  description     String
  order           Int
  categoryId      String
  textContent     String
  videoUrl        String?
  videoThumbnail  String?
  isPremium       Boolean          @default(false)
  parentTopicId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  exampleProblems ExampleProblem[]
  flashcards      Flashcard[]
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parentTopic     Topic?           @relation("TopicSubtopics", fields: [parentTopicId], references: [id])
  subtopics       Topic[]          @relation("TopicSubtopics")
  topicProgress   TopicProgress[]
  Topic_A         Topic[]          @relation("TopicPrerequisites")
  Topic_B         Topic[]          @relation("TopicPrerequisites")

  @@index([categoryId])
  @@index([parentTopicId])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  order       Int
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@index([courseId])
}

model ExampleProblem {
  id         String     @id @default(cuid())
  topicId    String
  question   String
  solution   String
  difficulty Difficulty
  order      Int
  isPremium  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model Flashcard {
  id         String              @id @default(cuid())
  topicId    String
  front      String
  back       String
  hint       String?
  lessonPart Int? // Which lesson part this flashcard relates to (1, 2, 3, etc.)
  isPremium  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  topic      Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress   FlashcardProgress[]

  @@index([topicId])
}

model FlashcardProgress {
  id               String    @id @default(cuid())
  userId           String
  flashcardId      String
  /// Study context this progress belongs to: 'personal' (default deck),
  /// 'class:<classroomId>' (a class the student joined), or
  /// 'course:<courseSlug>' (a self-created course study mode). Each context is
  /// an independent deck — same card, separate SRS state. See src/lib/study-context.ts.
  context          String    @default("personal")
  easeFactor       Float     @default(2.5)
  interval         Int       @default(0)
  isMinuteInterval Boolean   @default(false) // True if interval is in minutes, false if in days
  repetitions      Int       @default(0)
  nextReview       DateTime  @default(now())
  lastReviewed     DateTime  @default(now())
  reviewCount      Int       @default(0)
  flashcard        Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId, context])
  @@index([userId, nextReview])
  @@index([userId, context, nextReview])
}

// Teacher-authored flashcard sets (manual, CSV/paste import, or AI-generated).
// Distinct from the global Flashcard model (which is keyed to a Topic and shared
// site-wide): a FlashcardSet is OWNED by a teacher and optionally scoped to one
// of their classrooms, so importing/generating cards never pollutes global content.
model FlashcardSet {
  id          String             @id @default(cuid())
  teacherId   String
  classroomId String? // optional: scope the set to one of the teacher's classes
  title       String
  subject     String?
  topicSlug   String? // optional topic this set relates to
  source      String             @default("MANUAL") // MANUAL | IMPORT | AI
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  teacher     User               @relation("TeacherFlashcardSets", fields: [teacherId], references: [id], onDelete: Cascade)
  classroom   Classroom?         @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  cards       FlashcardSetCard[]
  assignments Assignment[]

  @@index([teacherId])
  @@index([classroomId])
}

model FlashcardSetCard {
  id    String       @id @default(cuid())
  setId String
  front String
  back  String
  order Int          @default(0)
  set   FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

model TopicProgress {
  id              String         @id @default(cuid())
  userId          String
  topicId         String
  status          ProgressStatus @default(NOT_STARTED)
  masteryLevel    Float          @default(0)
  timeSpent       Int            @default(0)
  lastAccessed    DateTime       @default(now())
  completedAt     DateTime?
  variant         Int            @default(1) // Which content variant (1-3)
  failedExitParts Json? // Part numbers to redo after exit quiz failure, e.g. [2, 5, 7]
  masteredParts   Json? // Entrance-quiz-skipped part numbers, persisted server-side for cross-device sync
  topic           Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

model LearningPath {
  id           String    @id @default(cuid())
  userId       String    @unique
  topicOrder   String?
  currentTopic String?
  startDate    DateTime  @default(now())
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiagnosticTest {
  id                String           @id @default(cuid())
  userId            String
  category          String
  results           Json
  weakAreas         Json?
  strengths         String?
  classDiagnosticId String? // set when this attempt answered an assigned class diagnostic
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classDiagnostic   ClassDiagnostic? @relation(fields: [classDiagnosticId], references: [id], onDelete: SetNull)

  // Hot path: every diagnostic history/latest-attempt lookup filters on
  // (userId, category) ordered by createdAt desc.
  @@index([userId, category, createdAt])
  @@index([classDiagnosticId])
}

model DailyChallengeResult {
  id          String   @id @default(cuid())
  userId      String
  day         DateTime @db.Date
  score       Int
  total       Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// Per-day flashcard review rollup — powers the teacher's daily-habit view
// ("did each student do their flashcards 5-7 days this week?"). One row per
// user per UTC day, incremented best-effort on every card review.
model FlashcardDailyActivity {
  id      String   @id @default(cuid())
  userId  String
  day     DateTime @db.Date
  reviews Int      @default(0)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

model DailyStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id               String            @id @default(cuid())
  name             String
  description      String
  icon             String
  category         String
  criteria         String
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  category  String
  message   String
  status    String   @default("new") // new, read, replied, resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  topicSlug String
  title     String
  part      Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicSlug, part])
  @@index([userId])
}

model Announcement {
  id          String   @id @default(cuid())
  classroomId String
  authorId    String
  title       String
  content     String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  author    User      @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([classroomId, createdAt])
}

enum UserRole {
  FREE
  PREMIUM
  ADMIN
  TEACHER
}

enum AssignmentType {
  INTERACTIVE_LESSON
  FLASHCARD_REVIEW
  QUIZ
  COMPETITIVE_PRACTICE
  UNIT_TEST
  FRQ_PRACTICE
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum CompetitionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MASTERED
}

// Competitive Mode Models

model School {
  id         String      @id @default(cuid())
  name       String
  district   String?
  state      String?
  country    String      @default("USA")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  classrooms Classroom[]

  @@index([name])
}

model CompetitiveProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  overallMMR              Int       @default(1000)
  totalMatches            Int       @default(0)
  wins                    Int       @default(0)
  losses                  Int       @default(0)
  winStreak               Int       @default(0)
  bestWinStreak           Int       @default(0)
  averageAccuracy         Float     @default(0)
  averageSpeed            Float     @default(0)
  rank                    String    @default("Bronze")
  lastMatchAt             DateTime?
  competitiveModeUnlocked Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([overallMMR])
  @@index([rank])
}

model MatchmakingQueue {
  id        String   @id @default(cuid())
  userId    String   @unique
  topicSlug String
  mmr       Int
  gameMode  String   @default("SPEED_RACE")
  // Difficulty tier the waiting player selected ('easy'|'medium'|'hard'), so a
  // later joiner can be paired same-tier and the match runs at that tier. Null
  // = no preference (matches anyone).
  tier      String?
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicSlug, mmr])
}

model CompetitiveMatch {
  id               String          @id @default(cuid())
  player1Id        String
  player2Id        String
  gameMode         CompetitiveMode
  topicSlug        String
  player1Score     Int             @default(0)
  player2Score     Int             @default(0)
  player1Time      Int?
  player2Time      Int?
  winnerId         String?
  player1MMRBefore Int
  player2MMRBefore Int
  player1MMRAfter  Int
  player2MMRAfter  Int
  status           MatchStatus     @default(PENDING)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  gameData         Json? // Stores questions, answers, current question index
  player1          User            @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Cascade)
  player2          User            @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([startedAt])
  @@index([player1Id])
  @@index([player2Id])
}

// Async (turn-based) challenges — challenger plays first, then shares link for opponent to play later
model AsyncChallenge {
  id                 String               @id @default(cuid())
  challengerId       String
  recipientId        String? // null until recipient accepts
  topicSlug          String
  questionCount      Int                  @default(10)
  timeLimit          Int                  @default(300) // seconds per player
  questions          Json // pre-generated questions array
  challengerScore    Int                  @default(0)
  challengerTime     Int? // milliseconds to complete
  challengerAnswers  Json? // array of { questionIndex, answerIndex, correct, timeMs }
  recipientScore     Int?
  recipientTime      Int?
  recipientAnswers   Json?
  winnerId           String?
  status             AsyncChallengeStatus @default(CHALLENGER_PLAYING)
  expiresAt          DateTime // challenge expires if not accepted
  challengerPlayedAt DateTime?
  recipientPlayedAt  DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  challenger         User                 @relation("AsyncChallengeSender", fields: [challengerId], references: [id], onDelete: Cascade)
  recipient          User?                @relation("AsyncChallengeRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([challengerId])
  @@index([recipientId])
  @@index([status])
  @@index([expiresAt])
}

enum AsyncChallengeStatus {
  CHALLENGER_PLAYING // challenger is still answering
  WAITING_FOR_OPPONENT // challenger done, waiting for recipient
  RECIPIENT_PLAYING // recipient is answering
  COMPLETED // both done
  EXPIRED // not accepted before deadline
}

// Private head-to-head lobbies — host creates a code, guest joins, both can play multiple matches
model CompetitiveLobby {
  id             String      @id @default(cuid())
  code           String      @unique
  hostId         String
  guestId        String?
  // Open-lobby discovery: public lobbies appear in the /competitive/lobbies
  // browser so strangers can join without a code. topicSlug/gameMode are the
  // host's advertised intent (they still confirm per-match inside the lobby).
  isPublic       Boolean     @default(false)
  topicSlug      String?
  gameMode       String?
  difficulty     String?
  // Heartbeat: the host's room page refreshes this while open. Public lobbies
  // whose host hasn't been seen for 10 minutes are closed by the sweep in the
  // open-lobbies listing, so abandoned lobbies can't sit in the browser.
  hostLastSeenAt DateTime    @default(now())
  status         LobbyStatus @default(WAITING)
  currentMatchId String?
  lastMatchId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  closedAt       DateTime?
  host           User        @relation("LobbyHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest          User?       @relation("LobbyGuest", fields: [guestId], references: [id], onDelete: SetNull)

  @@index([hostId])
  @@index([guestId])
  @@index([status])
  @@index([isPublic, status])
}

enum LobbyStatus {
  WAITING // host alone, or host + guest, picking next challenge
  IN_MATCH // a match is currently in progress
  CLOSED // lobby closed by host or both left
}

// Teacher-created multi-student lobby with MMR-balanced team formation
model TeacherLobby {
  id             String             @id @default(cuid())
  joinCode       String             @unique
  teacherId      String
  classroomId    String?
  name           String
  topicSlug      String?
  courseSlug     String?
  topicSlugs     Json               @default("[]")
  durationSec    Int                @default(600)
  endsAt         DateTime?
  questionPool   Json?
  gameMode       String             @default("competitive")
  numTeams       Int                @default(2)
  // Student-hosted open lobbies run on this same engine: the host is a student
  // (teacherId holds their id), plays as a participant, and the lobby can be
  // publicly listed. format: TEAM_2V2 (cap 4, MMR-balanced) or RACE_FFA
  // (cap maxPlayers, every player their own team, assigned at start).
  studentHosted  Boolean            @default(false)
  isPublic       Boolean            @default(false)
  maxPlayers     Int?
  format         String?
  difficulty     String?
  hostLastSeenAt DateTime           @default(now())
  status         TeacherLobbyStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  startedAt      DateTime?
  closedAt       DateTime?

  teacher      User                      @relation("TeacherLobbyTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  classroom    Classroom?                @relation("TeacherLobbyClassroom", fields: [classroomId], references: [id], onDelete: SetNull)
  participants TeacherLobbyParticipant[]

  @@index([teacherId])
  @@index([classroomId])
  @@index([joinCode])
  @@index([status])
  @@index([isPublic, status])
}

model TeacherLobbyParticipant {
  id                String   @id @default(cuid())
  lobbyId           String
  userId            String
  team              Int? // 0..numTeams-1, null until balanced
  mmrAtJoin         Int      @default(1000)
  joinedAt          DateTime @default(now())
  score             Int      @default(0)
  questionsAnswered Int      @default(0)
  questionsCorrect  Int      @default(0)
  lastQuestionIndex Int      @default(0)

  lobby TeacherLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user  User         @relation("TeacherLobbyParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@index([lobbyId])
  @@index([userId])
}

enum TeacherLobbyStatus {
  OPEN // accepting joiners
  IN_PROGRESS // teams assigned, match running
  CLOSED // ended
}

model MMRHistory {
  id          String          @id @default(cuid())
  userId      String
  matchId     String?
  topicSlug   String
  mmrBefore   Int
  mmrAfter    Int
  mmrChange   Int
  gameMode    CompetitiveMode
  performance String?
  timestamp   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([userId, topicSlug])
}

model Leaderboard {
  id        String            @id @default(cuid())
  scope     LeaderboardScope
  scopeId   String?
  period    LeaderboardPeriod
  topicSlug String?
  rankings  Json
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())

  @@unique([scope, scopeId, period, topicSlug])
  @@index([scope, period])
}

enum CompetitiveMode {
  SPEED_RACE
  ACCURACY_CHALLENGE
  SURVIVAL
  MIXED
  TEAM_BATTLE
  CHAOS
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeaderboardScope {
  GLOBAL
  SCHOOL
  CLASS
  REGION
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

// Six Sigma Statistical Process Control Models

model FactoringPerformanceMetrics {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())

  // Session Information
  sessionId   String // Groups attempts in same study session
  problemType String // 'gcf', 'difference-of-squares', 'simple-trinomials', etc.
  lessonPart  Int // Which part of the 6-part lesson (1-6)

  // Performance Data
  isCorrect     Boolean
  attemptNumber Int // 1st, 2nd, 3rd attempt on this problem
  timeToAnswer  Int // milliseconds
  hintsUsed     Int     @default(0)

  // Problem Difficulty
  problemDifficulty String // 'EASY', 'MEDIUM', 'HARD'
  problemComplexity Float // 1-5 scale based on coefficients, terms, etc.

  // Error Classification (for Root Cause Analysis)
  errorType     String? // 'sign-error', 'multiplication-error', 'factoring-incomplete', etc.
  errorCategory String? // 'conceptual', 'computational', 'careless'

  // User reference
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, problemType])
  @@index([userId, sessionId])
  @@index([userId, timestamp])
  @@index([userId, lessonPart])
}

model SixSigmaMetrics {
  id           String   @id @default(cuid())
  userId       String
  topicSlug    String // 'factoring-algebra1'
  calculatedAt DateTime @default(now())

  // === CONTROL CHART METRICS ===
  // Average performance over rolling window
  accuracyMean      Float // Mean accuracy (0-1)
  accuracyStdDev    Float // Standard deviation
  upperControlLimit Float // UCL = mean + 3*stddev
  lowerControlLimit Float // LCL = mean - 3*stddev

  // Speed metrics
  avgTimePerProblem Float // Average time in seconds
  timeStdDev        Float // Time standard deviation

  // === DEFECT METRICS (DPMO) ===
  // Defects Per Million Opportunities
  totalAttempts Int
  totalErrors   Int
  dpmo          Float // (errors/attempts) * 1,000,000
  sigmaLevel    Float // Calculated sigma level (1-6)

  // === PROCESS CAPABILITY ===
  // How consistently student performs within "specification limits" (target mastery)
  cpk Float // Process capability index
  cp  Float // Process capability

  // Target specification limits (what we want students to achieve)
  targetAccuracy Float @default(0.90) // 90% target
  toleranceLower Float @default(0.70) // Acceptable lower bound
  toleranceUpper Float @default(1.00) // Perfect upper bound

  // === BY PROBLEM TYPE ===
  // JSON field storing metrics broken down by each factoring type
  performanceByType Json // { "gcf": { accuracy: 0.95, dpmo: 50000 }, ... }

  // === IMPROVEMENT TRACKING ===
  trendDirection     String // 'improving', 'stable', 'declining'
  consecutiveCorrect Int // Current streak
  longestStreak      Int // Best streak

  // === STATISTICAL OUTLIERS ===
  hasOutliers   Boolean   @default(false)
  outlierCount  Int       @default(0)
  lastOutlierAt DateTime?

  // User reference
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicSlug])
  @@index([userId, calculatedAt])
}

// ==========================================================================
// TEACHER DASHBOARD MODELS
// ==========================================================================

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  joinCode    String   @unique // 6-char code students use to join
  teacherId   String
  schoolId    String?
  subject     String? // e.g., "AP Calculus", "Algebra 1"
  grade       String? // e.g., "9th", "10th"
  section     String? // e.g., "Period 3", "Section A" — free-text label for teachers with multiple sections
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher           User                   @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  school            School?                @relation(fields: [schoolId], references: [id])
  members           ClassroomMember[]
  courses           ClassroomCourse[]
  assignments       Assignment[]
  competitions      ScheduledCompetition[]
  competitiveGrants CompetitiveGrant[]
  announcements     Announcement[]
  teacherLobbies    TeacherLobby[]         @relation("TeacherLobbyClassroom")
  liveSessions      LiveSession[]
  classDiagnostics  ClassDiagnostic[]

  curriculumPlans CurriculumPlan[]
  flashcardSets   FlashcardSet[]
  coTeachers      ClassroomCoTeacher[]

  @@index([teacherId])
  @@index([joinCode])
}

// The courses a classroom actually teaches — Khan Academy's class-course model.
// Assignment creation filters its topic picker to these, replacing a single
// dropdown of every topic on the platform (~1,000 options) with only the
// classroom's own material. Managed in the classroom Settings tab.
model ClassroomCourse {
  id          String    @id @default(cuid())
  classroomId String
  // Course slug, or 'mcat-competitive' for the competitive-bank pseudo-course
  // that /api/teacher/topics exposes alongside DB courses.
  courseSlug  String
  createdAt   DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, courseSlug])
  @@index([classroomId])
}

// Co-teachers: teachers (other than the owner) granted access to a classroom.
// Kept in a SEPARATE table from ClassroomMember so it never pollutes the
// student-centric member queries (rosters, analytics, gradebook, counts).
model ClassroomCoTeacher {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  addedAt     DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation("CoTeaching", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model CompetitiveGrant {
  id          String   @id @default(cuid())
  studentId   String
  grantedById String // teacher who granted access
  classroomId String? // optional classroom context
  categories  Json? // JSON array of category slugs, null = all categories
  createdAt   DateTime @default(now())

  student   User       @relation("CompetitiveGrantStudent", fields: [studentId], references: [id], onDelete: Cascade)
  grantedBy User       @relation("CompetitiveGrantTeacher", fields: [grantedById], references: [id], onDelete: Cascade)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([studentId, grantedById])
  @@index([studentId])
}

model ExitQuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  topicSlug      String // e.g., 'sat-linear-equations-inequalities'
  score          Int // number correct (out of 10)
  totalQuestions Int      @default(10)
  passed         Boolean  @default(false) // true if score >= 7
  mustRedoUnit   Boolean  @default(false) // true if score < 5
  variant        Int      @default(1) // Which content variant this attempt was for
  answers        Json // array of { questionId, selectedAnswer, correct }
  startedAt      DateTime @default(now())
  completedAt    DateTime @default(now())
  timeSpent      Int      @default(0) // seconds

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topicSlug])
  @@index([userId])
}

model ClassroomMember {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())
  isActive    Boolean  @default(true)
  nickname    String? // optional display name within class

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model Assignment {
  id             String         @id @default(cuid())
  classroomId    String
  createdById    String
  title          String
  description    String?
  type           AssignmentType
  topicSlug      String? // specific topic to complete
  topicSlugs     Json? // array of topic slugs for multi-topic assignments
  quizId         String? // if type is QUIZ
  flashcardSetId String? // if type is FLASHCARD_REVIEW, the teacher-created set to study
  courseSlug     String? // if type is UNIT_TEST or FRQ_PRACTICE — these are scoped to a course, not a topic
  unitId         String? // if type is UNIT_TEST — a specific unit, or null for "any unit in the course"
  dueDate        DateTime?
  maxAttempts    Int            @default(1)
  requiredScore  Float? // minimum mastery/score required (0-1)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  classroom    Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  flashcardSet FlashcardSet?          @relation(fields: [flashcardSetId], references: [id], onDelete: SetNull)
  submissions  AssignmentSubmission[]

  @@index([classroomId])
  @@index([createdById])
  @@index([dueDate])
  @@index([flashcardSetId])
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  status         AssignmentStatus @default(NOT_STARTED)
  score          Float? // 0-1 mastery/score achieved
  attempts       Int              @default(0)
  timeSpent      Int              @default(0) // seconds
  startedAt      DateTime?
  completedAt    DateTime?
  feedback       String? // teacher feedback
  gradedManually Boolean          @default(false) // teacher-entered grade — auto-grading must not touch
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
}

model ScheduledCompetition {
  id          String            @id @default(cuid())
  classroomId String
  title       String
  topicSlug   String // competitive topic
  gameMode    CompetitiveMode   @default(SPEED_RACE)
  status      CompetitionStatus @default(SCHEDULED)
  scheduledAt DateTime // when competition opens
  endsAt      DateTime // when competition closes
  duration    Int               @default(600) // match duration in seconds
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  classroom    Classroom                @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  participants CompetitionParticipant[]

  @@index([classroomId])
  @@index([scheduledAt])
  @@index([status])
}

model CompetitionParticipant {
  id            String    @id @default(cuid())
  competitionId String
  userId        String
  score         Float? // final score
  accuracy      Float? // accuracy percentage
  timeSpent     Int? // seconds
  rank          Int? // final placement
  matchId       String? // reference to competitive match if created
  joinedAt      DateTime  @default(now())
  completedAt   DateTime?

  competition ScheduledCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([userId])
}

model LearningInsights {
  id          String   @id @default(cuid())
  userId      String
  topicSlug   String
  generatedAt DateTime @default(now())

  // === ROOT CAUSE ANALYSIS ===
  // What specific skills need work?
  weakestSkills   Json // ["sign-convention", "perfect-square-recognition"]
  strongestSkills Json // ["gcf-identification", "difference-of-squares"]

  // Error pattern analysis
  commonErrors        Json // [{ type: "sign-error", frequency: 12, impact: "high" }]
  improvementPriority String // 'critical', 'high', 'medium', 'low'

  // === PERSONALIZED RECOMMENDATIONS ===
  recommendedPractice    Json // [{ type: "simple-trinomials", reason: "Below target" }]
  estimatedTimeToMastery Int // Minutes of focused practice needed
  confidenceLevel        Float // 0-1 how confident the system is in mastery

  // === COMPARATIVE ANALYTICS ===
  percentileRank    Float // How student compares to peers (0-100)
  comparedToAverage Float // How far above/below average (-1 to +1)

  // === PARETO ANALYSIS ===
  // 80/20 rule - which 20% of error types cause 80% of problems?
  criticalErrorTypes Json // Top error types to address first

  // User reference
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicSlug])
  @@index([userId, generatedAt])
}

// ─── Student Notes ────────────────────────────────────────────────────
model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  topicSlug String
  content   String   @db.Text
  // Optional freeform sketch stored as compact JSON strokes (see DrawingData in
  // src/lib/drawing.ts). Nullable — most notes are text-only.
  drawing   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicSlug])
  @@index([userId])
}

// ─── Study Planner ───────────────────────────────────────────────────
model StudyPlan {
  id          String      @id @default(cuid())
  userId      String
  title       String
  examDate    DateTime?
  goalType    String      @default("AP_EXAM") // AP_EXAM, UNIT_TEST, FINAL, CUSTOM
  courseSlug  String?
  targetScore Int? // Target AP score (1-5) or percentage
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       StudyTask[]

  @@index([userId, isActive])
}

model StudyTask {
  id          String    @id @default(cuid())
  planId      String
  topicSlug   String?
  title       String
  type        String    @default("LESSON") // LESSON, FLASHCARD, QUIZ, PRACTICE, CUSTOM
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, completed])
  @@index([dueDate])
}

// ─── Daily/Weekly Challenges ─────────────────────────────────────────
model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String // DAILY, WEEKLY
  category    String // FLASHCARD, LESSON, QUIZ, COMPETITIVE, STREAK
  requirement Int // e.g. "5" flashcard reviews
  xpReward    Int      @default(50)
  icon        String   @default("🎯")
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  participants ChallengeParticipant[]

  @@index([type, startsAt])
  @@index([endsAt])
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  xpEarned    Int       @default(0)
  joinedAt    DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, completed])
}

// ─── Curriculum Planner (Teacher) ────────────────────────────────────
model CurriculumPlan {
  id          String           @id @default(cuid())
  classroomId String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  weeks       CurriculumWeek[]

  @@index([classroomId])
}

model CurriculumWeek {
  id      String           @id @default(cuid())
  planId  String
  weekNum Int
  title   String?
  notes   String?          @db.Text
  items   CurriculumItem[]
  plan    CurriculumPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekNum])
}

model CurriculumItem {
  id        String         @id @default(cuid())
  weekId    String
  topicSlug String?
  title     String
  type      String         @default("LESSON") // LESSON, ASSIGNMENT, QUIZ, ACTIVITY
  sortOrder Int            @default(0)
  notes     String?
  week      CurriculumWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@index([weekId])
}

model SatTestAttempt {
  id          String   @id @default(cuid())
  userId      String
  testNumber  Int // which practice test (1, 2, 3...)
  rwScore     Int // Reading & Writing scaled score (200-800)
  mathScore   Int // Math scaled score (200-800)
  totalScore  Int // Combined score (400-1600)
  rwCorrect   Int // Number of R&W questions correct
  rwTotal     Int // Total R&W questions
  mathCorrect Int // Number of math questions correct
  mathTotal   Int // Total math questions
  timeSpent   Int      @default(0) // Total time in seconds
  answers     Json // Full answer data per section
  weakAreas   Json? // Array of weak topic areas
  strengths   Json? // Array of strong topic areas
  completed   Boolean  @default(true)
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, testNumber])
}

model McatTestAttempt {
  id          String   @id @default(cuid())
  userId      String
  sectionId   String // e.g. 'chem-phys', 'cars', 'bio-biochem', 'psych-soc'
  sectionName String // Display name of the section
  score       Int // Scaled section score (118-132)
  maxScore    Int      @default(132)
  percentage  Int // Percentage correct
  correct     Int // Number correct
  total       Int // Total questions
  timeSpent   Int      @default(0) // Total time in seconds
  answers     Json // Full answer data
  completed   Boolean  @default(true)
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sectionId])
}

// Unit-test completions. Every course's unit-test page renders through the
// shared UnitTestsClient, so persisting here covers all of them at once.
// Until this existed a student could work every unit test in a course and
// their teacher saw nothing.
model UnitTestAttempt {
  id          String   @id @default(cuid())
  userId      String
  courseSlug  String // e.g. 'ap-biology'
  unitId      String // which unit within the course
  unitTitle   String
  variant     Int      @default(1) // which of the unit's test variations
  correct     Int
  total       Int
  percentage  Int
  timeSpent   Int      @default(0) // seconds
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, courseSlug])
  @@index([completedAt])
}

// Free-response practice sessions. Scored against the published rubric on the
// client; we store the totals so the work is visible to a teacher.
model FrqAttempt {
  id             String   @id @default(cuid())
  userId         String
  courseSlug     String // e.g. 'ap-biology'
  mode           String // 'practice' | 'timed'
  pointsEarned   Int
  pointsPossible Int
  frqCount       Int // how many free-response questions were in the set
  timeSpent      Int      @default(0) // seconds
  completedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, courseSlug])
  @@index([completedAt])
}

model EmailSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String   @default("website") // e.g. "sat-results", "topic-sidebar", "footer"
  interests    String[] @default([]) // e.g. ["sat", "ap-calculus"]
  verified     Boolean  @default(false)
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([source])
}

// ---------------------------------------------------------------------------
// Live class sessions — teacher-run video sessions for a classroom.
// CONFERENCE = everyone in an embedded Jitsi/JaaS room (small groups);
// WEBCAST   = teacher streams one-way (unlisted YouTube embed) and students
//             interact through the built-in chat, so viewer count is unlimited
//             and costs nothing. See src/lib/live-session.ts.
// ---------------------------------------------------------------------------

model LiveSession {
  id            String    @id @default(cuid())
  classroomId   String
  teacherId     String
  mode          String // 'CONFERENCE' | 'WEBCAST'
  status        String    @default("LIVE") // 'LIVE' | 'ENDED'
  roomName      String // unguessable Jitsi room slug (conference mode)
  streamVideoId String? // YouTube video id (webcast mode)
  mutedUserIds  Json? // string[] of userIds muted in this session's chat
  boardMode     String    @default("OFF") // class whiteboard: 'OFF' | 'TEACHER' (students watch) | 'SHARED' (students draw too)
  padsEnabled   Boolean   @default(false) // per-student pads + teacher gallery
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  classroom  Classroom               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  messages   LiveSessionMessage[]
  boards     LiveBoard[]
  attendance LiveSessionAttendance[]
  decks      SlideDeck[]

  @@index([classroomId, status])
  @@index([status])
}

model LiveSessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  userName  String // denormalized display name — chat renders without N user lookups
  body      String
  hidden    Boolean  @default(false) // moderated away by the teacher
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// A whiteboard scene in a live session. ownerKey 'class' = the shared class
// board; otherwise the owning student's userId (their personal pad). scene is
// { elements: ExcalidrawElement[], files: BinaryFiles } — merged element-wise
// on write (see src/lib/board-merge.ts), so concurrent drawers converge.
model LiveBoard {
  id        String   @id @default(cuid())
  sessionId String
  ownerKey  String // 'class' | userId
  ownerName String // denormalized display name for the teacher's pad gallery
  scene     Json
  rev       Int      @default(0)
  updatedAt DateTime @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, ownerKey])
  @@index([sessionId, updatedAt])
}

// ---------------------------------------------------------------------------
// Assigned class diagnostics — one generated test, identical for the whole
// roster (owner decision: comparable results; generated ONCE at assign time
// and stored, rather than per-student). Students take it through the course's
// normal diagnostic page (?assigned=<id>), so scoring, recommendations, the
// retake gate, and the class plan all keep working unchanged.
// ---------------------------------------------------------------------------

model ClassDiagnostic {
  id          String    @id @default(cuid())
  classroomId String
  courseKey   String // class-plan-config key: 'mcat', 'sat', …
  title       String // "Diagnostic 1" — auto-numbered per classroom+course
  testData    Json // the frozen generated test (questions, domains, time limit)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  classroom Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attempts  DiagnosticTest[]

  @@index([classroomId, courseKey, createdAt])
}

// Live-session attendance — who was in the room and for how long. Row is
// created when a student loads the session page; lastSeenAt advances on their
// chat/board/status polls, so minutes ≈ lastSeenAt - joinedAt.
model LiveSessionAttendance {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// In-class slide presentations. A deck is auto-generated from a topic's lesson
// content (content slides) interleaved with poll slides drawn from the topic's
// exit-quiz pool, presented inside a live session: the teacher advances
// slides, students' views follow, poll answers aggregate live. See
// src/lib/slide-deck.ts and the DeckSection on /live/[id].
// ---------------------------------------------------------------------------

model SlideDeck {
  id           String   @id @default(cuid())
  sessionId    String
  topicSlug    String
  title        String
  slides       Json // Slide[] — see src/lib/slide-deck.ts
  currentSlide Int      @default(0)
  revealed     Json? // number[] — poll slide indexes whose answers are revealed
  status       String   @default("ACTIVE") // ACTIVE | ENDED
  createdAt    DateTime @default(now())

  session   LiveSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses SlideResponse[]

  @@index([sessionId, status])
}

model SlideResponse {
  id          String   @id @default(cuid())
  deckId      String
  slideIndex  Int
  userId      String
  userName    String // denormalized for the teacher's responder list
  answerIndex Int
  createdAt   DateTime @default(now())

  deck SlideDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, slideIndex, userId])
  @@index([deckId, slideIndex])
}

// Pre-generated slide decks per curriculum topic (owner request: slides "made"
// for every MCAT and SAT subtopic, browsable before class). Presenting uses
// the stored deck when one exists; scripts/generate-topic-slide-decks.ts
// (re)builds them from lesson content + flashcards + exit-quiz polls.
model TopicSlideDeck {
  id          String   @id @default(cuid())
  topicSlug   String   @unique
  courseSlug  String
  title       String
  slides      Json
  slideCount  Int
  pollCount   Int
  generatedAt DateTime @default(now())

  @@index([courseSlug])
}
