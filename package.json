{
  "name": "calculus-learning-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:courses": "node --import tsx prisma/seed-courses.ts",
    "seed:chemistry": "node --import tsx prisma/seed-chemistry-categories.ts && npm run seed:chem-all",
    "seed:chem-all": "for file in prisma/seed-chem-*.ts; do node --import tsx \"$file\"; done",
    "seed:all": "tsx prisma/seed-all.ts",
    "typecheck": "tsc --noEmit",
    "depth:check": "tsx scripts/run-depth-audit.ts",
    "speed:baseline": "tsx scripts/run-mobile-speed-baseline.ts",
    "smoke:routes": "tsx scripts/run-smoke-checks.ts",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,css,json}'",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run seed:all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@auth/prisma-adapter": "^2.11.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@prisma/client": "^6.18.0",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.90.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.25",
    "lucide-react": "^1.25.0",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta.29",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "stripe": "^19.1.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "glob": "^13.0.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
