{
  "name": "calculus-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:courses": "node --import tsx prisma/seed-courses.ts",
    "seed:chemistry": "node --import tsx prisma/seed-chemistry-categories.ts && npm run seed:chem-all",
    "seed:chem-all": "for file in prisma/seed-chem-*.ts; do node --import tsx \"$file\"; done",
    "seed:all": "tsx prisma/seed-all.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,css,json}'",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run seed:all"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.0",
    "@prisma/client": "^6.18.0",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.90.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "bcryptjs": "^3.0.2",
    "katex": "^0.16.25",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "stripe": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "glob": "^13.0.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
