# ================================
# Study Mondo — Environment Variables
# ================================
# Copy this file to .env and fill in the values

# ---- Database (Required) ----
# PostgreSQL connection string (e.g., Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- NextAuth (Required) ----
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ---- Google OAuth (Optional — enables Google Sign-In) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Stripe (Optional — enables premium subscriptions) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# ---- Upstash Redis (Optional — enables rate limiting & caching) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Sentry (Optional — error monitoring) ----
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ---- Stripe Client (Optional — client-side Stripe Elements) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=""

# ---- Google AdSense (Optional — enables ad banners) ----
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=""
NEXT_PUBLIC_AD_SLOT_SIDEBAR=""
NEXT_PUBLIC_AD_SLOT_TOPIC_BOTTOM=""

# ---- Google Analytics 4 (Optional) ----
# Get your measurement ID from https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---- Microsoft Clarity (Optional — heatmaps/session replay) ----
# Get your project ID from https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# ---- App Configuration ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Email (Required for email verification & password reset) ----
# Create an API key at https://resend.com/api-keys. Email is sent via the Resend
# HTTP API; SMTP_FROM is just the From display address (the SMTP_* host vars are
# NOT used by this codebase).
RESEND_API_KEY=""
SMTP_FROM="Study Mondo <noreply@studymondo.com>"

# ============================================================
# PRODUCTION NOTE: several "Optional" blocks above are effectively REQUIRED in
# production — without them a core feature silently fails:
#   - UPSTASH_REDIS_*  -> API rate limiting + login brute-force lockout fail OPEN
#   - RESEND_API_KEY   -> ALL transactional email throws (no verify/reset emails)
#   - STRIPE_*         -> checkout 503s / webhook 500s (no upgrades)
#   - NEXT_PUBLIC_APP_URL / NEXTAUTH_URL must be the real prod origin (not localhost)
# NEXT_PUBLIC_* are inlined at BUILD time — changing them requires a redeploy.
# ============================================================

# ---- NextAuth secret fallback ----
# Some paths read NEXTAUTH_SECRET as a fallback for AUTH_SECRET; set both the same.
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ---- Cron jobs (Required in prod — all scheduled jobs 401 without it) ----
# Vercel Cron auto-sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="generate-a-strong-random-value"

# ---- Health check (Optional — gates non-trivial /api/health diagnostics) ----
HEALTH_CHECK_SECRET=""

# ---- Email link origin (Optional) ----
# Origin used to build links in emails; defaults to NEXT_PUBLIC_APP_URL.
EMAIL_PUBLIC_APP_URL=""
# Dev-only: allow localhost links in emails. DO NOT set in production.
ALLOW_LOCAL_EMAIL_LINKS=""

# ---- AI tutor (Optional — without a key, "Explain differently" serves canned text) ----
# The /api/ai/explain route uses real AI only if a key is set.
OPENAI_API_KEY=""

# ---- Stripe annual plan (Optional — enables the Annual toggle on /pricing) ----
# Create an annual recurring Price in Stripe; the annual plan stays hidden until this is set.
STRIPE_PREMIUM_ANNUAL_PRICE_ID=""

# ---- Admin alerting (Optional — funnel-regression alerts, contact-form notifications) ----
# Comma-separated email lists. ADMIN_ALERT_EMAIL_TO also receives contact-form messages.
ADMIN_ALERT_EMAIL_TO=""
ADMIN_ALERT_OWNER_EMAILS=""
ADMIN_ALERT_SLACK_WEBHOOK_URL=""
ADMIN_ALERT_WEBHOOK_URL=""
ADMIN_ALERT_COOLDOWN_HOURS=""
ADMIN_ALERT_RUNBOOK_URLS=""
ADMIN_ALERT_TICKET_PROVIDER=""
ADMIN_ALERT_TICKET_WEBHOOK_URL=""
ADMIN_ALERT_ESCALATION_EMAIL_TO=""
ADMIN_ALERT_ESCALATION_WEBHOOK_URL=""
ADMIN_ALERT_ESCALATION_LOOKBACK_DAYS=""
ADMIN_ALERT_ESCALATION_REPEAT_THRESHOLD=""

# ---- Content-depth report (Optional — weekly report delivery target) ----
CONTENT_DEPTH_WEBHOOK_URL=""
